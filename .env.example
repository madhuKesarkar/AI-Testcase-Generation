# ============================================================
#  LLM PROVIDER  -  openai | ollama | google
#  Everything below the provider block is provider-specific;
#  only the vars for your chosen provider need values.
# ============================================================
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.4

# ---- ollama (free, local) --------------------------------
#   1. install:  https://ollama.com
#   2. ollama pull llama3.1:8b
#   3. ollama pull nomic-embed-text
LLM_MODEL=llama3.1:8b
# (ChatOllama talks to http://localhost:11434 by default)

# ---- google / gemini (free tier, no credit card) --------
#   key:  https://aistudio.google.com/apikey
# LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=

# ---- openai (paid) --------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ============================================================
#  EMBEDDINGS  (semantic duplicate detection)
#  Defaults to match LLM_PROVIDER. Leave blank to use the
#  default model for that provider. If unavailable, dedupe
#  falls back to exact-title matching automatically.
#    ollama -> nomic-embed-text   (ollama pull nomic-embed-text)
#    google -> models/text-embedding-004
#    openai -> text-embedding-3-small
# ============================================================
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
DUPLICATE_SIMILARITY_THRESHOLD=0.86

# ============================================================
#  Optional: LangSmith tracing (see every chain step in a UI)
#  https://smith.langchain.com
# ============================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=ai-testcase-generation

# ============================================================
#  DESTINATION  -  where generated test cases are uploaded
#  linear | testrail
# ============================================================
DESTINATION_SYSTEM=linear

# ---- Linear -------------------------------------------------
#   key:  Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=
#   pick ONE way to point at a team:
LINEAR_TEAM_KEY=QA
# LINEAR_TEAM_ID=
#   optional niceties:
LINEAR_LABEL=ai-testcase
LINEAR_CREATE_PARENT=true

# ---- TestRail (only if DESTINATION_SYSTEM=testrail) --------
TESTRAIL_BASE_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=
TESTRAIL_DEFAULT_SECTION_ID=

# ============================================================
#  Jira (only if you later fetch issues instead of receiving
#  full webhook payloads)
# ============================================================
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
